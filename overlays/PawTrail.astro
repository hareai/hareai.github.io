---
const { count = 5 } = Astro.props;
---
<span class="paw-trail" aria-hidden="true">
  {Array.from({ length: count }).map(() => (
    <svg viewBox="0 0 24 24">
      <ellipse cx="12" cy="17.2" rx="4.4" ry="3.1" />
      <ellipse cx="6.2" cy="10.8" rx="1.45" ry="2.55" />
      <ellipse cx="10.2" cy="6.4" rx="1.4" ry="2.7" />
      <ellipse cx="13.8" cy="6.4" rx="1.4" ry="2.7" />
      <ellipse cx="17.8" cy="10.8" rx="1.45" ry="2.55" />
    </svg>
  ))}
</span>
